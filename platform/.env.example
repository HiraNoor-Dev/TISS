# Copy to .env.local. Use a separate database; never point this at the prototype.
DATABASE_URL=postgresql://tiss:tiss_local_only@localhost:5432/tiss_platform
APP_ORIGIN=http://localhost:3100
# Set a random value of at least 32 characters. Used to hash login throttle keys.
AUTH_RATE_SECRET=
# Result messages stay disabled until the school completes Meta Business setup.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=vXX.X
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RESULT_TEMPLATE=school_test_result
WHATSAPP_CORRECTION_TEMPLATE=school_test_result_correction
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
